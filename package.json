{
  "name": "pakkon",
  "version": "0.1.0",
  "private": true,
  "description": "Make photos and videos safe to share, fully offline: remove hidden location, device and time data, and mask faces and licence plates.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "python3 scripts/make_fixtures.py"
  },
  "dependencies": {
    "exifr": "7.1.3",
    "mediabunny": "1.61.6",
    "onnxruntime-web": "1.30.0",
    "vazirmatn": "33.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "all-the-cities": "3.1.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
