{
  "name": "traceless",
  "version": "0.1.0",
  "private": true,
  "description": "Make photos, videos and voice notes safe to share, fully offline: remove hidden location, device and time data, cover faces and licence plates, change voices. Web app, command-line tool and MCP server for AI agents.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "traceless": "dist-cli/traceless.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "python3 scripts/make_fixtures.py",
    "images": "npm run build && node scripts/readme-images.mjs && node scripts/og-images.mjs",
    "build:cli": "vite build --config vite.cli.config.ts",
    "test:cli": "npm run build:cli && node scripts/smoke-cli.mjs",
    "mcp": "node dist-cli/traceless.mjs mcp"
  },
  "dependencies": {
    "exifr": "7.1.3",
    "jpeg-js": "0.4.4",
    "mediabunny": "1.61.6",
    "onnxruntime-web": "1.30.0",
    "pngjs": "7.0.0",
    "vazirmatn": "33.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "all-the-cities": "3.1.0",
    "axe-core": "4.14.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
